# Copy to .env.local and adjust. Values below match docker-compose.yml for local development.

DATABASE_URL=postgres://fixit:fixit@localhost:5432/fixit

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Storage (SeaweedFS locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_ACCESS_KEY_ID=fixit
S3_SECRET_ACCESS_KEY=fixit-secret
S3_PUBLIC_BUCKET=fixit-public
S3_PRIVATE_BUCKET=fixit-private
S3_PUBLIC_URL=http://localhost:8333/fixit-public
S3_FORCE_PATH_STYLE=true

# Email (optional locally: without a key, emails are printed in the terminal)
RESEND_API_KEY=
EMAIL_FROM=Fix It Now <no-reply@example.com>

# Cloudflare Turnstile. These are Cloudflare's official test keys that always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Business details shown on the site
NEXT_PUBLIC_PHONE=+359888123456
NEXT_PUBLIC_VIBER=+359888123456
NEXT_PUBLIC_WHATSAPP=+359888123456
NEXT_PUBLIC_EMAIL=office@example.com

# Show the design switcher (Design 1-4) for comparing the alternative front ends
NEXT_PUBLIC_SHOW_VARIANTS=true
